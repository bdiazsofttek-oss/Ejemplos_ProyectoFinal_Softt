{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisionEventInput",
  "description": "Evento de observaciones del adaptador de visión. El restaurante se obtiene de la ruta y la sesión, no del cuerpo.",
  "type": "object",
  "required": [
    "eventType",
    "source"
  ],
  "properties": {
    "eventType": {
      "enum": [
        "table_unattended",
        "detection_summary"
      ]
    },
    "tableId": {
      "type": [
        "string",
        "null"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "properties": {
        "inference": {
          "type": "boolean"
        },
        "mode": {
          "type": "string"
        },
        "frameIndex": {
          "type": "integer",
          "minimum": 0
        },
        "guests": {
          "type": "integer",
          "minimum": 0
        },
        "waiterPresent": {
          "type": "boolean"
        },
        "dishDelivered": {
          "type": "boolean"
        },
        "secondsSinceService": {
          "type": "number",
          "minimum": 0
        },
        "classes": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
